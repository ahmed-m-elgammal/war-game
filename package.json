    "test:e2e": "playwright test",
    "validate:tasks": "node scripts/validate-tasks.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "9.39.5",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "5.0.5"
  }
}
