# -----------------------------------------------------------------------------
# WARGAME Environment Configuration Template
# NOTE: Never commit real credentials or production secrets to this file.
# Copy this file to .env.local or your deployment secret store.
# -----------------------------------------------------------------------------

# --- Server Runtime ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/wargame
DATABASE_URL_MIGRATIONS=postgresql://postgres:postgres@localhost:54322/wargame

# --- Supabase Auth & JWT ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- RevenueCat (IAP Entitlements) ---
REVENUECAT_SECRET_API_KEY=your-revenuecat-secret-api-key
REVENUECAT_WEBHOOK_AUTH=your-revenuecat-webhook-authorization-token

# --- Sentry Observability (Optional in local dev) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Cloudflare Tunnel & Storage (Production / Staging) ---
CLOUDFLARE_TUNNEL_TOKEN=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Web & Mobile Client Public Variables (Vite) ---
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SENTRY_DSN=
